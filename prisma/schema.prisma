// Eva Studio — schema real (Supabase Postgres compartilhado com o Beeno
// Builder, mas com tabelas isoladas via prefixo eva_studio_ pra nunca
// encostar nas tabelas do outro produto nesse mesmo banco).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// pgvector entra via previewFeatures no generator acima; o tipo em si e
// declarado como Unsupported porque o Prisma nao tem um mapeamento nativo —
// leitura e escrita de embedding sao feitas em SQL cru (src/lib/server/embeddings.ts).

model Organization {
  id        String   @id @default(uuid())
  name      String
  logoUrl   String?
  createdAt DateTime @default(now())

  profiles    Profile[]
  agents      Agent[]
  credentials Credential[]
  apiKeys     ApiKey[]
  mcpServers  McpServer[]
  contacts    Contact[]
  companies   Company[]
  tags        Tag[]
  segments    Segment[]
  pipelines   Pipeline[]
  deals       Deal[]
  tasks       Task[]
  notes       Note[]
  dashboard   DashboardLayout?

  @@map("eva_studio_organizations")
}

// Chave de API pública (igual Stripe/HubSpot/Salesforce) — dá acesso
// programático aos dados dessa org via /api/v1/*, sem precisar de sessão
// logada. Só o hash é guardado (SHA-256); a chave em si só existe uma vez,
// no momento em que é criada — depois disso é irrecuperável, só dá pra
// revogar e gerar outra (mesmo modelo de "copie agora, não mostramos de
// novo" que toda API séria usa).
model ApiKey {
  id         String    @id @default(uuid())
  orgId      String
  name       String // "Produção", "Integração n8n", etc. — só pra identificar
  keyPrefix  String // primeiros caracteres, tipo "evs_live_4f2a9b" — pra reconhecer qual é qual sem descriptografar nada
  keyHash    String // SHA-256 da chave inteira
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([keyHash])
  @@map("eva_studio_api_keys")
}

// Chave de API reutilizável entre agentes (Groq, Resend, ...) — cadastrada
// uma vez pela org, referenciada por nome em qualquer bloco que precise dela
// (Agente de IA, Enviar e-mail). O valor fica cifrado (ver src/lib/server/crypto.ts),
// nunca volta em texto puro pro cliente depois de criado.
model Credential {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  type      String // "groq" | "resend"
  secretEnc String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("eva_studio_credentials")
}

model Profile {
  id        String   @id // = Supabase auth user id
  orgId     String
  name      String
  email     String
  // Papel dentro da organização (RBAC). "owner" = quem criou a org, não pode
  // ser rebaixado nem removido; "admin" = mexe em tudo; "agent" = atendente,
  // só Conversas/Contatos e responder; "viewer" = só leitura. Checagem
  // central em src/lib/server/permissions.ts.
  role      String   @default("owner") // owner | admin | agent | viewer
  createdAt DateTime @default(now())

  organization    Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversations   Conversation[] @relation("ConversationAssignee")
  ownedContacts   Contact[]      @relation("ContactOwner")
  ownedCompanies  Company[]      @relation("CompanyOwner")
  ownedDeals      Deal[]         @relation("DealOwner")
  assignedTasks   Task[]         @relation("TaskAssignee")
  authoredNotes   Note[]         @relation("NoteAuthor")
  messages        Message[]      @relation("MessageAuthor")

  @@index([orgId])
  @@map("eva_studio_profiles")
}

model Agent {
  id             String   @id @default(uuid())
  orgId          String
  name           String
  description    String   @default("")
  tone           String   @default("")
  language       String   @default("Português")
  primaryChannel String   @default("")
  instructions   String   @default("") @db.Text
  guidelines     String   @default("") @db.Text
  skills         Json     @default("[]")
  tools          Json     @default("[]")
  outboundUrl    String   @default("")
  status         String   @default("active")
  // Widget de chat pra colar em qualquer site (canal "website") — puxa
  // assunto sozinho e alimenta a página Leads. Ver docs/CHATBOT_ENGINE.md §12.
  widgetEnabled  Boolean  @default(false)
  // Busca semantica na base de conhecimento (§19). Vazio = desligada, e a
  // busca cai no full-text do Postgres, que era o comportamento anterior.
  embeddingProvider     String  @default("")
  embeddingCredentialId String  @default("")
  embeddingModel        String  @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  variables         AgentVariable[]
  knowledgeBase     KnowledgeDoc[]
  flow              AgentFlow?
  whatsappConnection WhatsAppConnection?
  metaConnection     MetaConnection?
  instagramConnection InstagramConnection?
  conversations      Conversation[]
  messageTemplates   MessageTemplate[]
  outboundQueue       OutboundQueueItem[]
  broadcasts          Broadcast[]
  commentAutomations  CommentAutomation[]
  executions          FlowExecution[]
  contactChannels     ContactChannel[]
  sequences           Sequence[]
  telegramConnection  TelegramConnection?
  messengerConnection MessengerConnection?
  tiktokConnection    TikTokConnection?
  knowledgeChunks     KnowledgeChunk[]

  @@index([orgId])
  @@map("eva_studio_agents")
}

// Uma linha por "rodada" da conversa (cada vez que advanceConversation roda),
// gravando o caminho percorrido no fluxo — pra existir uma aba de Execuções
// tipo n8n em vez de só o estado atual (Conversation.currentNodeId).
model FlowExecution {
  id             String   @id @default(uuid())
  agentId        String
  conversationId String
  status         String // "success" | "error"
  steps          Json // [{nodeId, kind, label, input, output, error?, ms}]
  createdAt      DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@map("eva_studio_flow_executions")
}

model AgentVariable {
  id      String @id @default(uuid())
  agentId String
  name    String
  unit    String @default("")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("eva_studio_agent_variables")
}

// content = texto já extraído do arquivo (PDF/DOCX/TXT), pronto pra ser
// injetado no prompt do agente. Não é busca semântica (sem embeddings/vetor)
// — pra poucos documentos pequenos, mandar o texto inteiro já resolve bem;
// ver docs/CHATBOT_ENGINE.md sobre o porquê dessa escolha.
model KnowledgeDoc {
  id         String   @id @default(uuid())
  agentId    String
  fileName   String
  sizeBytes  Int
  mimeType   String
  content    String   @default("") @db.Text
  uploadedAt DateTime @default(now())

  agent  Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([agentId])
  @@map("eva_studio_knowledge_docs")
}

// Pedaco de documento com embedding (busca semantica). Um documento vira N
// chunks; cada chunk guarda o vetor do texto dele.
//
// Por que chunk separado do documento: o KnowledgeDoc guarda o texto inteiro
// (usado pelo modo antigo, sem vetor); aqui a granularidade e a que a busca
// precisa. Os dois convivem — desligar embeddings volta pro full-text sem
// perder nada.
//
// O campo embedding e Unsupported porque o Prisma nao tem tipo vector: insercao e
// busca por distancia sao SQL cru em src/lib/server/embeddings.ts. A dimensao
// e fixa em 1536 pra um indice servir a todos os provedores — os modelos
// usados ou sao 1536 nativos ou aceitam pedir 1536.
model KnowledgeChunk {
  id         String                       @id @default(uuid())
  agentId    String
  docId      String
  chunkIndex Int
  text       String                       @db.Text
  embedding  Unsupported("vector(1536)")?
  // Modelo que gerou o vetor — vetor de modelo diferente nao e comparavel,
  // entao reindexar ao trocar de modelo depende de saber isso.
  model      String                       @default("")
  createdAt  DateTime                     @default(now())

  agent Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  doc   KnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([docId])
  @@map("eva_studio_knowledge_chunks")
}

// Um bloco só por agente (o canvas do Builder de conversa) — nodes/edges do
// React Flow como JSON livre, o shape é definido no frontend (FlowNodeData).
model AgentFlow {
  agentId   String   @id
  nodes     Json
  edges     Json
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("eva_studio_agent_flows")
}

// Conexão de WhatsApp via QR code (Baileys, não a API oficial da Meta) — o
// worker (processo separado, rodando fora da Vercel) lê/escreve essa linha
// pra gerenciar a sessão. creds/keys são o estado de autenticação do Baileys
// (protocolo Signal), serializado como JSON pra persistir entre reinícios do
// worker sem precisar escanear o QR de novo.
model WhatsAppConnection {
  agentId     String   @id
  status      String   @default("disconnected") // disconnected | requesting | qr_pending | connected
  qrDataUrl   String?  @db.Text
  phoneNumber String?
  creds       Json?
  keys        Json?
  lastError   String?
  updatedAt   DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("eva_studio_whatsapp_connections")
}

// Canal oficial (Meta Cloud API) — dorme até existirem credenciais de app
// Meta configuradas (ver README do worker/META_SETUP.md); o webhook em
// /api/webhooks/meta já está pronto pra receber assim que isso existir.
// accessToken é cifrado em repouso (AES-256-GCM) via src/lib/server/crypto.ts
// quando TOKEN_ENCRYPTION_KEY existe — grava/lê pelas rotas, nunca em texto
// puro em produção. Linhas antigas em texto puro continuam legíveis (migração
// sem downtime) e passam a ser cifradas no próximo update.
model MetaConnection {
  agentId       String   @id
  phoneNumberId String   @unique
  wabaId        String
  accessToken   String   @db.Text
  displayPhone  String?
  createdAt     DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("eva_studio_meta_connections")
}

// Estado de uma conversa (um contato falando com um agente, em um canal).
// currentNodeId = onde parou no fluxo; variables = tudo que já foi capturado
// (respostas de Captura de input, resultado de Chamar webhook, etc.); status
// controla se o motor ainda responde sozinho ou se está pausado esperando
// (transferido pra humano) ou já terminou.
model Conversation {
  id                   String    @id @default(uuid())
  agentId              String
  channel              String // playground | whatsapp_qr | whatsapp_meta | instagram | website
  contactId            String // telefone/jid, id de sessão do Playground, ou id gerado no navegador do visitante (website)
  currentNodeId        String?
  variables            Json      @default("{}")
  // active        = o agente responde
  // waiting_human = o agente passou e ninguem assumiu ainda (precisa de gente)
  // human         = um atendente assumiu; o agente fica mudo ate devolverem
  // ended         = encerrada; a proxima mensagem do contato recomeca o fluxo
  status               String    @default("active") // active | waiting_human | human | ended
  // Última vez que o CONTATO mandou algo (texto ou toque de botão) — é o que
  // abre/fecha a janela de 24h da Meta (regra oficial do WhatsApp Business:
  // fora dela só se pode mandar mensagem de modelo pré-aprovado). Ver
  // docs/CHATBOT_ENGINE.md.
  lastContactMessageAt DateTime?
  // Estágio do lead pro CRM interno (canal "website") — null = "Novo". Não
  // tem efeito nenhum no motor de fluxo, é só pra organizar a página Leads.
  leadStage            String?
  // Ficha do contato (Contact) por trás dessa conversa — preenchida na
  // primeira vez que a conversa roda. Conversas antigas ficam null até o
  // próximo advanceConversation. Ver docs/CHATBOT_ENGINE.md §13.
  contactRecordId      String?
  // Atendente responsável (inbox humano). null = ninguém pegou ainda.
  assignedToId         String?
  // Quando alguém da equipe abriu a conversa pela última vez. Não lida =
  // existe mensagem do contato depois disso. É um marcador da conversa, não
  // por pessoa: numa caixa compartilhada, "alguém já viu" é o que evita dois
  // atendentes abrirem a mesma conversa achando que é nova.
  readAt               DateTime?
  // Última mensagem, copiada pra cá. Listar 50 conversas com a prévia de cada
  // custava uma consulta de mensagens por linha; assim a lista sai de uma
  // tabela só e ordena por quem escreveu por último, não por quem foi mexida.
  lastMessageAt        DateTime  @default(now())
  lastMessageText      String    @default("")
  lastMessageRole      String    @default("")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  agent      Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages   Message[]
  contact    Contact?  @relation(fields: [contactRecordId], references: [id], onDelete: SetNull)
  assignedTo Profile?  @relation("ConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@unique([agentId, channel, contactId])
  @@index([contactRecordId])
  @@index([assignedToId])
  @@index([agentId, lastMessageAt])
  @@index([agentId, status])
  @@map("eva_studio_conversations")
}

// Modelo de mensagem (equivalente ao "Message Template" da Meta) — o texto de
// verdade só é aprovado no Meta Business Manager; aqui a gente só guarda o
// que já foi aprovado, pra poder escolher no bloco de Mensagem quando a
// conversa estiver fora da janela de 24h. metaTemplateName/metaLanguageCode
// têm que ser IDÊNTICOS ao que foi registrado na Meta, e variableOrder é a
// ordem das variáveis {var} no bodyText — usada pra montar os parâmetros
// posicionais {{1}}, {{2}}... que a API de templates da Meta exige.
model MessageTemplate {
  id               String   @id @default(uuid())
  agentId          String
  name             String
  category         String   @default("utility") // utility | marketing | authentication
  bodyText         String   @db.Text
  metaTemplateName String   @default("")
  metaLanguageCode String   @default("pt_BR")
  variableOrder    Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("eva_studio_message_templates")
}

// Transcrição de verdade — cada mensagem trocada, na ordem. Alimenta a
// página "Conversas". role "human" = atendente respondeu manualmente (ver
// inbox humano em §9 do CHATBOT_ENGINE.md), diferente de "bot" (motor/IA).
model Message {
  id             String   @id @default(uuid())
  conversationId String
  // contact = quem escreveu de fora | bot = o agente | human = atendente
  // note    = nota interna da equipe. NUNCA sai pro cliente e NUNCA entra no
  //           contexto da IA (ver loadConversationHistory).
  role           String // contact | bot | human | note
  text           String   @db.Text
  authorId       String?
  // Anexo. O arquivo mora no storage, não no banco: aqui só o caminho.
  mediaPath      String?
  mediaType      String? // image | audio | video | document | sticker
  mediaMime      String?
  mediaName      String?
  mediaSize      Int?
  // Id do lado de fora: wamid da Meta, ou o id do item da fila do worker. É o
  // que permite o recibo de entrega (enviado, entregue, lido) achar a mensagem.
  externalId     String?
  // sending | queued | sent | delivered | read | failed
  deliveryStatus String   @default("sent")
  deliveryError  String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       Profile?     @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([externalId])
  @@map("eva_studio_messages")
}

// Canal oficial de Instagram (Instagram Messaging API) — mesma ideia do
// MetaConnection, mas com os ids/token próprios do Instagram (não são o
// mesmo phoneNumberId/WABA do WhatsApp). Conectado via Instagram Login
// (OAuth direto — instagram-connect.tsx) quando INSTAGRAM_APP_ID/SECRET
// existirem, ou cadastro manual antes disso. pageAccessToken, apesar do
// nome, é o token de acesso da conta Instagram no fluxo novo (Instagram API
// with Instagram Login não usa mais Página do Facebook) — ver
// docs/meta-business-runbook.html.
model InstagramConnection {
  agentId          String   @id
  igBusinessId     String   @unique // Instagram-scoped business account id (ou user_id, no Instagram Login)
  pageAccessToken  String   @db.Text
  username         String?
  createdAt        DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("eva_studio_instagram_connections")
}

// Automação "comente X e recebe DM" (igual o recurso de comentário do
// ManyChat) — quando um comentário num post/reel do Instagram bate com o
// gatilho, manda uma resposta pública opcional e uma mensagem privada (via
// API de private reply da Meta). Depois disso, a conversa cai no fluxo
// normal do Builder (currentNodeId fica null — a próxima mensagem do
// contato entra pelo "Início" como qualquer conversa nova). Ver
// docs/CHATBOT_ENGINE.md §12.
model CommentAutomation {
  id           String   @id @default(uuid())
  agentId      String
  name         String
  mediaId      String   @default("") // vazio = qualquer post/reel da conta
  keyword      String   @default("") // vazio = qualquer comentário; senão, lista separada por vírgula
  publicReply  String   @default("") @db.Text
  dmMessage    String   @db.Text
  active       Boolean  @default(true)
  triggerCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("eva_studio_comment_automations")
}

// Fila de envio pro WhatsApp via QR (Baileys) — o app principal (serverless)
// não segura o socket do Baileys, então em vez de mandar direto, ele grava
// aqui e o worker (processo sempre ligado) drena por polling. Usada por (1)
// resposta manual de atendente numa conversa em waiting_human e (2) disparos
// em massa (Disparos). Canal whatsapp_meta não passa por aqui — a Vercel
// consegue chamar a Graph API direto, de forma síncrona.
model OutboundQueueItem {
  id             String    @id @default(uuid())
  agentId        String
  contactId      String
  text           String    @db.Text
  broadcastId    String?
  variantId      String?
  // Preenchido quando o item veio de uma Sequencia (drip) — serve pra
  // contabilizar entrega por passo e pra nao reenviar o mesmo passo.
  enrollmentId   String?
  // Anexo (resposta de atendente com arquivo). O worker pede a URL assinada ao
  // app, porque quem tem a chave do storage é o app, não ele.
  mediaPath      String?
  mediaType      String?
  mediaMime      String?
  mediaName      String?
  status         String    @default("pending") // pending | sent | failed
  error          String?
  createdAt      DateTime  @default(now())
  sentAt         DateTime?
  // Quando o contato respondeu depois de receber esse item. So e usado pelo
  // placar do teste A/B, e por isso e gravado uma vez so (segunda resposta
  // nao conta de novo).
  repliedAt      DateTime?

  agent     Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  broadcast Broadcast?        @relation(fields: [broadcastId], references: [id], onDelete: SetNull)
  variant   BroadcastVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([broadcastId])
  @@index([variantId])
  @@index([agentId, contactId, sentAt])
  @@map("eva_studio_outbound_queue")
}

// Uma campanha de disparo (mesma mensagem/modelo pra uma lista de contatos).
// Pra whatsapp_meta o envio é síncrono (Graph API, direto na rota); pra
// whatsapp_qr cada destinatário vira uma linha em OutboundQueueItem que o
// worker drena — sentCount/failedCount aqui são atualizados conforme o
// worker confirma cada envio.
model Broadcast {
  id          String   @id @default(uuid())
  agentId     String
  channel     String // whatsapp_qr | whatsapp_meta | telegram
  text        String   @db.Text
  templateId  String?
  totalCount  Int      @default(0)
  sentCount   Int      @default(0)
  failedCount Int      @default(0)
  status      String   @default("sending") // scheduled | sending | done | canceled
  // Como o publico foi escolhido: "manual" = lista colada a mao (comportamento
  // antigo, continua valendo), "segment" = todos os contatos que batem com um
  // Segment salvo, "tags" = contatos que tem as etiquetas de tagIds.
  audience    String   @default("manual") // manual | segment | tags
  segmentId   String?
  tagIds      Json     @default("[]")
  // Lista colada a mao (audience="manual"). Fica guardada pra que um
  // disparo manual tambem possa ser agendado — senao "manual" seria o unico
  // publico que nao aceita hora marcada, sem motivo bom.
  manualRecipients Json @default("[]")
  // Quando disparar. null = agora (comportamento antigo). Com data no futuro
  // o status nasce "scheduled" e quem envia de verdade e o worker, que faz
  // polling — a Vercel no plano gratis so permite cron 1x/dia, entao o
  // agendamento NAO vive la. Ver docs/CHATBOT_ENGINE.md §15.
  scheduledAt DateTime?
  createdAt   DateTime @default(now())

  agent    Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  queue    OutboundQueueItem[]
  segment  Segment?            @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  variants BroadcastVariant[]

  @@index([agentId])
  @@index([status, scheduledAt])
  @@map("eva_studio_broadcasts")
}

// Variante de um teste A/B de disparo. Se um Broadcast tem variantes, cada
// destinatario recebe UMA delas (sorteio ponderado por weight) e o placar de
// entrega fica por variante — e assim que se compara duas mensagens de
// verdade, em vez de no olho. Sem variantes, o disparo usa Broadcast.text
// normalmente.
model BroadcastVariant {
  id          String   @id @default(uuid())
  broadcastId String
  label       String // "A", "B", ...
  text        String   @db.Text
  templateId  String?
  weight      Int      @default(1)
  sentCount   Int      @default(0)
  failedCount Int      @default(0)
  replyCount  Int      @default(0) // quantos responderam depois de receber essa variante
  createdAt   DateTime @default(now())

  broadcast Broadcast           @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  queue     OutboundQueueItem[]

  @@index([broadcastId])
  @@map("eva_studio_broadcast_variants")
}

// Contador de rate limit (janela fixa). Usado por src/lib/server/rate-limit.ts
// pra proteger rotas públicas/abusáveis (widget, signup) sem depender de
// Redis externo. `key` = identificador da janela (ex: "signup:<ip>",
// "widget:<agentId>:<ip>"); `count` reinicia quando `windowStart` vence.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@map("eva_studio_rate_limits")
}


// ---------------------------------------------------------------------------
// CRM de contatos (§13 do CHATBOT_ENGINE.md)
// ---------------------------------------------------------------------------

// Ficha do contato — a pessoa por tras das conversas, nao a conversa em si.
// Antes disso o "contato" era so a string Conversation.contactId (telefone,
// igsid, id de visitante) e tudo que o fluxo capturava ficava num JSON solto
// dentro da conversa, invisivel pro resto do app. Agora nome/e-mail/telefone
// sao colunas de verdade, o resto vira customFields, e o bloco de Captura
// escreve aqui automaticamente quando o nome da variavel bate (ver
// CAPTURE_FIELD_MAP em src/lib/server/contacts.ts).
model Contact {
  id           String    @id @default(uuid())
  orgId        String
  companyId    String?
  // Vendedor/atendente dono da ficha (o "sales_id" do Atomic CRM).
  ownerId      String?
  name         String    @default("")
  jobTitle     String    @default("")
  // Principais — continuam colunas pra busca, filtro de segmento e pra
  // interpolar {email}/{telefone} em mensagem sem ter que ler JSON.
  email        String    @default("")
  phone        String    @default("")
  // Secundarios, com rotulo: [{ value, label }]. Lead tem dois telefones o
  // tempo todo, e antes disso a gente sobrescrevia o primeiro.
  emails       Json      @default("[]")
  phones       Json      @default("[]")
  linkedinUrl  String    @default("")
  background   String    @default("") @db.Text
  notes        String    @default("") @db.Text
  customFields Json      @default("{}")
  source       String    @default("conversa")
  optIn        Boolean   @default(true)
  optOutAt     DateTime?
  lastSeenAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organization  Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company       Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner         Profile?             @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  channels      ContactChannel[]
  conversations Conversation[]
  tags          ContactTag[]
  deals         DealContact[]
  tasks         Task[]
  crmNotes      Note[]
  enrollments   SequenceEnrollment[]

  @@index([orgId])
  @@index([orgId, email])
  @@index([orgId, phone])
  @@index([companyId])
  @@map("eva_studio_contacts")
}

// Onde falar com a pessoa. Foi extraido de Contact pra que a mesma pessoa
// no WhatsApp e no Instagram seja UMA ficha, e pra que Empresa e Negocio
// tenham onde se pendurar sem ficarem presos a um chatbot.
model ContactChannel {
  id         String   @id @default(uuid())
  contactId  String
  agentId    String
  channel    String // whatsapp_qr | whatsapp_meta | instagram | telegram | messenger | tiktok | website | playground
  externalId String // telefone, igsid, chat_id, id de visitante
  createdAt  DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  agent   Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  // A chave unica que era de Contact migrou inteira pra ca.
  @@unique([agentId, channel, externalId])
  @@index([contactId])
  @@map("eva_studio_contact_channels")
}

// Etiqueta (igual "tag" do ManyChat) — o jeito mais simples de segmentar.
// Aplicar uma etiqueta e o gatilho mais usado pra entrar numa sequencia.
model Tag {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  color     String   @default("slate")
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contacts     ContactTag[]
  sequences    Sequence[]   @relation("SequenceTriggerTag")

  @@unique([orgId, name])
  @@index([orgId])
  @@map("eva_studio_tags")
}

model ContactTag {
  contactId String
  tagId     String
  addedAt   DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
  @@map("eva_studio_contact_tags")
}

// Publico salvo. rules e uma lista de condicoes combinadas por "match"
// (all = E, any = OU): [{ field, op, value }] onde field pode ser um campo
// da ficha (name/email/phone/optIn/createdAt), "tag" (tem/nao tem a etiqueta)
// ou "custom:<chave>". A traducao pra consulta Prisma vive em
// src/lib/server/segments.ts — nada de SQL montado com string.
model Segment {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  match     String   @default("all") // all | any
  rules     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  broadcasts   Broadcast[]
  sequences    Sequence[]   @relation("SequenceTriggerSegment")

  @@index([orgId])
  @@map("eva_studio_segments")
}

// ---------------------------------------------------------------------------
// Sequencias / drip (§14 do CHATBOT_ENGINE.md)
// ---------------------------------------------------------------------------

// Uma regua de mensagens com espera entre elas. O contato entra sozinho
// (auto-enrollment) quando ganha uma etiqueta ou passa a bater com um
// segmento, ou entra a mao pela tela de Contatos.
model Sequence {
  id               String   @id @default(uuid())
  agentId          String
  name             String
  channel          String   @default("whatsapp_meta")
  active           Boolean  @default(false)
  // "tag" = quando a etiqueta triggerTagId e aplicada; "segment" = quando o
  // contato passa a bater com triggerSegmentId; "stage" = quando um negocio
  // do contato entra na etapa triggerStageId; "manual" = so inscricao a mao.
  trigger          String   @default("manual") // tag | segment | stage | manual
  triggerTagId     String?
  triggerSegmentId String?
  triggerStageId   String?
  // So para trigger "stage": exige que o negocio esteja parado na etapa ha
  // pelo menos N dias. 0 = entra assim que chega na etapa. E o que separa
  // "acabou de entrar em Proposta" de "esta esquecido em Proposta ha uma
  // semana", que sao reguas completamente diferentes.
  triggerStageDays Int      @default(0)
  // Nao reinscreve quem ja passou pela sequencia.
  allowReentry     Boolean  @default(false)
  // Sai da sequencia se o contato responder qualquer coisa — o padrao certo
  // pra follow-up, senao a regua continua cutucando quem ja respondeu.
  stopOnReply      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  agent          Agent                @relation(fields: [agentId], references: [id], onDelete: Cascade)
  steps          SequenceStep[]
  enrollments    SequenceEnrollment[]
  triggerTag     Tag?                 @relation("SequenceTriggerTag", fields: [triggerTagId], references: [id], onDelete: SetNull)
  triggerSegment Segment?             @relation("SequenceTriggerSegment", fields: [triggerSegmentId], references: [id], onDelete: SetNull)
  triggerStage   PipelineStage?       @relation("SequenceTriggerStage", fields: [triggerStageId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@map("eva_studio_sequences")
}

// Um passo da regua. delayMinutes conta a partir do passo anterior (ou da
// inscricao, no passo 1). Fora da janela de 24h o passo precisa de
// templateId, mesma regra do bloco de Mensagem.
model SequenceStep {
  id           String   @id @default(uuid())
  sequenceId   String
  order        Int
  delayMinutes Int      @default(60)
  text         String   @db.Text
  templateId   String?
  // Etiqueta aplicada ao contato quando esse passo e entregue — permite
  // encadear uma sequencia na outra.
  applyTagId   String?
  createdAt    DateTime @default(now())

  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, order])
  @@index([sequenceId])
  @@map("eva_studio_sequence_steps")
}

// Inscricao de um contato numa sequencia. nextRunAt e o relogio: o worker
// procura inscricoes ativas com nextRunAt vencido e entrega o proximo passo.
model SequenceEnrollment {
  id            String   @id @default(uuid())
  sequenceId    String
  contactId     String
  currentStep   Int      @default(0) // ultimo passo entregue; 0 = nenhum ainda
  nextRunAt     DateTime
  status        String   @default("active") // active | done | stopped
  stoppedReason String? // "respondeu" | "opt-out" | "manual"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, contactId])
  @@index([status, nextRunAt])
  @@index([contactId])
  @@map("eva_studio_sequence_enrollments")
}

// ---------------------------------------------------------------------------
// Canal Telegram (§16 do CHATBOT_ENGINE.md)
// ---------------------------------------------------------------------------

// Telegram e o canal mais simples que existe: um token de bot do @BotFather,
// um webhook registrado e pronto — sem App Review, sem janela de 24h, sem
// modelo aprovado. botToken e cifrado em repouso igual aos tokens da Meta.
model TelegramConnection {
  agentId     String   @id
  botToken    String   @db.Text
  botUsername String   @default("")
  webhookSet  Boolean  @default(false)
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("eva_studio_telegram_connections")
}


// ---------------------------------------------------------------------------
// Servidores MCP (Model Context Protocol) — §20 do CHATBOT_ENGINE.md
// ---------------------------------------------------------------------------

// Um servidor MCP cadastrado pela organizacao. MCP e o protocolo aberto que
// padroniza "aqui estao minhas ferramentas" — em vez de configurar uma
// chamada HTTP por integracao, o servidor se apresenta e o agente descobre
// sozinho o que da pra fazer.
//
// Ficam na organizacao, nao no agente: o mesmo servidor normalmente serve
// varios agentes, e cadastrar a credencial uma vez so e o ponto.
//
// authHeader guarda o cabecalho inteiro ja pronto (ex: "Bearer xyz"),
// cifrado em repouso igual aos outros segredos do app.
model McpServer {
  id          String   @id @default(uuid())
  orgId       String
  name        String
  url         String
  authHeader  String   @default("") @db.Text
  // Ultimo inventario de ferramentas visto, pra tela e Builder mostrarem o
  // que existe sem ter que bater no servidor a cada render.
  toolsCache  Json     @default("[]")
  lastCheckAt DateTime?
  lastError   String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("eva_studio_mcp_servers")
}


// ---------------------------------------------------------------------------
// Facebook Messenger (§21 do CHATBOT_ENGINE.md)
// ---------------------------------------------------------------------------

// Messenger e o canal mais parecido com o que ja existe: mesma Graph API,
// mesmo webhook compartilhado (/api/webhooks/meta), so muda o body.object
// ("page") e o envio (/me/messages com recipient.id em vez de "to").
//
// pageId e unico porque o webhook da Meta descobre o agente por ele, do mesmo
// jeito que o WhatsApp descobre pelo phoneNumberId.
model MessengerConnection {
  agentId         String   @id
  pageId          String   @unique
  pageAccessToken String   @db.Text
  pageName        String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("eva_studio_messenger_connections")
}

// ---------------------------------------------------------------------------
// TikTok Business Messaging (§22 do CHATBOT_ENGINE.md)
// ---------------------------------------------------------------------------

// TikTok usa a Business API (business-api.tiktok.com/open_api/v1.3), com
// OAuth proprio e token de vida curta: o access token vale ~24h e o refresh
// ~30 dias, entao a renovacao e parte do funcionamento normal, nao um caso
// de excecao.
//
// Duas travas que nao dependem da gente: a API e restrita por regiao (nao
// atende conta registrada no EEE, Suica e Reino Unido) e exige aprovacao do
// app no portal de desenvolvedor.
model TikTokConnection {
  agentId       String    @id
  businessId    String    @unique
  accessToken   String    @db.Text
  refreshToken  String    @default("") @db.Text
  expiresAt     DateTime?
  displayName   String    @default("")
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("eva_studio_tiktok_connections")
}


// ---------------------------------------------------------------------------
// CRM de vendas (§24 do CHATBOT_ENGINE.md)
// ---------------------------------------------------------------------------

model Company {
  id          String   @id @default(uuid())
  orgId       String
  name        String
  // tax_identifier do Atomic CRM; aqui e CNPJ, e state_abbr virou uf.
  cnpj        String   @default("")
  sector      String   @default("")
  size        Int?
  website     String   @default("")
  phone       String   @default("")
  linkedinUrl String   @default("")
  address     String   @default("")
  city        String   @default("")
  uf          String   @default("")
  zipcode     String   @default("")
  description String   @default("") @db.Text
  revenue     String   @default("")
  logoUrl     String   @default("")
  ownerId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner        Profile?     @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts     Contact[]
  deals        Deal[]

  @@index([orgId])
  @@index([orgId, cnpj])
  @@map("eva_studio_companies")
}

// Funil. O Atomic CRM tem um so, com a etapa como texto solto — aqui e
// entidade pra existir mais de um funil (Vendas, Pos-venda, Recuperacao)
// com etapas proprias.
model Pipeline {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  isDefault Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stages       PipelineStage[]
  deals        Deal[]

  @@index([orgId])
  @@map("eva_studio_pipelines")
}

model PipelineStage {
  id         String @id @default(uuid())
  pipelineId String
  name       String
  position   Int    @default(0)
  // Probabilidade padrao da etapa: o negocio herda ao entrar e pode
  // sobrescrever. E o que faz sair previsao ponderada sem digitar nada.
  probability Int   @default(0)
  // "open" | "won" | "lost". Sem isso o sistema nao sabe qual etapa
  // significa ganho, e nao da pra calcular taxa de conversao.
  type       String @default("open")

  pipeline  Pipeline   @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals     Deal[]
  sequences Sequence[] @relation("SequenceTriggerStage")

  @@index([pipelineId])
  @@map("eva_studio_pipeline_stages")
}

model Deal {
  id                String    @id @default(uuid())
  orgId             String
  pipelineId        String
  stageId           String
  companyId         String?
  ownerId           String?
  name              String
  description       String    @default("") @db.Text
  category          String    @default("")
  // Centavos, nao decimal: dinheiro em float e bug esperando acontecer.
  amountCents       Int       @default(0)
  currency          String    @default("BRL")
  probability       Int       @default(0)
  lostReason        String    @default("")
  expectedClosingAt DateTime?
  closedAt          DateTime?
  archivedAt        DateTime?
  // Ordem do card dentro da coluna do kanban (o "index" do Atomic CRM).
  position          Int       @default(0)
  // Quando entrou na etapa atual. updatedAt nao serve: qualquer edicao no
  // negocio o move, e "parado ha 7 dias" viraria mentira.
  stageSince        DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  pipeline     Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage        PipelineStage @relation(fields: [stageId], references: [id])
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner        Profile?      @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts     DealContact[]
  tasks        Task[]
  notes        Note[]

  @@index([orgId, stageId])
  @@index([pipelineId])
  @@index([companyId])
  @@map("eva_studio_deals")
}

model DealContact {
  dealId    String
  contactId String
  role      String @default("") // "decisor", "tecnico", "financeiro"...

  deal    Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([dealId, contactId])
  @@index([contactId])
  @@map("eva_studio_deal_contacts")
}

// No Atomic CRM a tarefa so amarra em contato e contact_id e obrigatorio.
// Aqui os dois sao opcionais: tarefa pode ser de um contato, de um negocio
// ou dos dois.
model Task {
  id           String    @id @default(uuid())
  orgId        String
  contactId    String?
  dealId       String?
  assignedToId String?
  type         String    @default("ligar") // ligar | email | reuniao | outro
  text         String    @db.Text
  dueAt        DateTime?
  doneAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  assignedTo   Profile?     @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([orgId, doneAt, dueAt])
  @@index([assignedToId, doneAt])
  @@index([contactId])
  @@index([dealId])
  @@map("eva_studio_tasks")
}

// O Atomic CRM tem contact_notes e deal_notes separadas: e a mesma coisa
// duas vezes, e toda tela que mostra as duas junta na mao.
model Note {
  id          String   @id @default(uuid())
  orgId       String
  contactId   String?
  dealId      String?
  authorId    String?
  text        String   @db.Text
  attachments Json     @default("[]")
  createdAt   DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  author       Profile?     @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([contactId, createdAt])
  @@index([dealId, createdAt])
  @@map("eva_studio_notes")
}

// Painel montado pela propria pessoa: quais cartoes existem, em que ordem,
// com que nome e ligados em qual numero. Um por organizacao — dashboard
// pessoal por usuario viraria "cada um ve um numero diferente na reuniao".
model DashboardLayout {
  id        String   @id @default(uuid())
  orgId     String   @unique
  // [{ id, tipo, fonte, titulo, largura, periodo }]
  widgets   Json
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("eva_studio_dashboard_layouts")
}
